{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Flight Parser (With Analysis)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "cwd": "${workspaceFolder}",
            "args": [
                "-analyze=true",
                "-in=mock/trace-landing.mock.json",
                "-out=output/flight_track.geojson"
            ]
        },
        {
            "name": "Launch analysis for landing dataset",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "cwd": "${workspaceFolder}",
            "args": [
                "-in=mock/trace-landing.mock.json",
                "-analyze=true",
            ]
        },
        {
            "name": "Launch Flight Parser (Skip Analysis)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "cwd": "${workspaceFolder}",
            "args": [
                "-analyze=false",
                "-out=flight_track_no_analysis.geojson"
            ]
        }
    ]
}